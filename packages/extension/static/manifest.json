{
  "manifest_version": 3,
  "name": "deffector — effector DevTools",
  "short_name": "deffector",
  "version": "0.1.4",
  "description": "DevTools for effector: each user action as one transaction, time travel, state injection, effect overrides, replayable traces.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/16-off.png",
      "32": "icons/32-off.png"
    },
    "default_title": "deffector: no effector agent on this page",
    "default_popup": "popup.html"
  },
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting", "activeTab"],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://*.localhost/*",
    "https://*.localhost/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "http://*.localhost/*",
        "https://*.localhost/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "homepage_url": "https://mxmvshnvsk.github.io/deffector/"
}
