{
  "name": "@deffector/standalone",
  "version": "0.1.5",
  "description": "DevTools for effector outside a browser tab: the deffector panel for SSR servers, Node scripts, tests and React Native",
  "keywords": [
    "effector",
    "devtools",
    "debugger",
    "ssr",
    "nodejs",
    "react-native",
    "time-travel"
  ],
  "homepage": "https://mxmvshnvsk.github.io/deffector/guide/node-ssr",
  "bugs": {
    "url": "https://github.com/mxmvshnvsk/deffector/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mxmvshnvsk/deffector.git",
    "directory": "packages/standalone"
  },
  "license": "MIT",
  "author": "Maxim Vishnevsky <mxmvshnvsk@gmail.com> (https://github.com/mxmvshnvsk)",
