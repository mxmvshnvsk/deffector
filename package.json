{
  "name": "deffector-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "DevTools for effector: transactions, time travel, state injection and trace record/replay",
  "license": "MIT",
  "workspaces": [
    "packages/protocol",
    "packages/agent",
    "packages/panel",
    "packages/extension",
    "packages/standalone",
    "demo/shared",
    "demo/react-vite",
    "demo/vue-vite",
    "demo/solid-vite",
    "demo/global-mode",
    "demo/no-plugin",
    "demo/node-ssr",
    "demo/next-ssr",
    "demo/lab",
    "website"
  ],
  "scripts": {
    "build": "npm run build -w @deffector/agent && npm run build -w @deffector-demo/shared && npm run build -w @deffector/extension && npm run build:firefox -w @deffector/extension && npm run build -w @deffector/standalone",
    "build:demo-shared": "npm run build -w @deffector-demo/shared",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.solid.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "release:check": "npm pack --dry-run -w @deffector/agent -w @deffector/standalone",
    "check:artifacts": "node ./scripts/check-artifacts.mjs",
    "dev:react": "npm run dev -w @deffector-demo/react-vite",
    "dev:vue": "npm run dev -w @deffector-demo/vue-vite",
    "dev:solid": "npm run dev -w @deffector-demo/solid-vite",
    "standalone": "node packages/standalone/bin/deffector.mjs",
    "dev:global": "npm run dev -w @deffector-demo/global-mode",
    "dev:no-plugin": "npm run dev -w @deffector-demo/no-plugin",
    "dev:node-ssr": "npm run dev -w @deffector-demo/node-ssr",
    "dev:next": "npm run dev -w @deffector-demo/next-ssr",
    "dev:lab": "npm run dev -w @deffector-demo/lab",
    "docs:dev": "npm run dev -w @deffector/website",
    "docs:build": "npm run build:demo-shared && npm run build -w @deffector/website"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@types/chrome": "^0.0.326",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.12",
    "eslint": "9.39.5",
    "eslint-config-airbnb-extended": "3.2.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.5.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsup": "8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "10.4.1"
  }
}
